{
  "openapi": "3.0.3",
  "info": {
    "title": "Service desk - agent API",
    "version": "1.0.0",
    "description": "Agent-facing subset of the servicedesk ORDS module (02-ords-module.sql + 06-write-handler.sql). Hand-enriched from the ORDS-generated spec: operationIds, real request bodies, declared envelopes, one security scheme."
  },
  "servers": [
    {
      "url": "https://<adb-host>/ords/<schema-alias>/servicedesk"
    }
  ],
  "security": [
    {
      "OAuth2": []
    }
  ],
  "paths": {
    "/tickets": {
      "get": {
        "operationId": "listTickets",
        "summary": "List tickets, newest first",
        "description": "Service tickets with queue code and assignee. Filter by status; page with limit/offset.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "OPEN, IN_PROGRESS or RESOLVED. Omit for all.",
            "schema": {
              "type": "string",
              "enum": [
                "OPEN",
                "IN_PROGRESS",
                "RESOLVED"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Rows per page. The handler default is 25; always check hasMore.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Zero-based row offset of the next page (previous offset + count).",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of tickets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketPage"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{reference}": {
      "get": {
        "operationId": "getTicket",
        "summary": "Get one ticket",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "description": "Ticket reference, e.g. TKT-1001.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "An envelope holding at most one ticket",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketPage"
                }
              }
            }
          }
        }
      }
    },
    "/summary": {
      "get": {
        "operationId": "getTicketSummary",
        "summary": "Open, high-priority and unassigned counts",
        "description": "Bare object: this handler returns no items/hasMore envelope.",
        "responses": {
          "200": {
            "description": "Counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/assign": {
      "post": {
        "operationId": "assignTickets",
        "summary": "Assign tickets to an engineer",
        "description": "Assigns every listed ticket that is not RESOLVED. Returns the real updated count plus updated and skipped references. Changes data: call only after the user confirms.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssignResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "ORDS OAuth2 client credentials (05-protect-module.sql + sql/create-oauth-client.sql).",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://<adb-host>/ords/<schema-alias>/oauth/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "Ticket": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "queue_code": {
            "type": "string"
          },
          "assigned_to": {
            "type": "string",
            "description": "Null when unassigned."
          },
          "created_date": {
            "type": "string",
            "description": "ISO-8601 UTC."
          }
        }
      },
      "TicketPage": {
        "type": "object",
        "required": [
          "items",
          "hasMore"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ticket"
            }
          },
          "hasMore": {
            "type": "boolean",
            "description": "More rows exist beyond this page. Never treat the page as complete while true."
          },
          "count": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "openCount": {
            "type": "integer"
          },
          "highCount": {
            "type": "integer"
          },
          "unassigned": {
            "type": "integer"
          }
        }
      },
      "AssignRequest": {
        "type": "object",
        "required": [
          "references",
          "assignee"
        ],
        "properties": {
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "assignee": {
            "type": "string",
            "description": "Engineer user name."
          },
          "assigned_by": {
            "type": "string",
            "description": "Who requested the change."
          }
        }
      },
      "AssignResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "updated_count": {
            "type": "integer"
          },
          "updated": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}